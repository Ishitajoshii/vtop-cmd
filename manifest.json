{
  "manifest_version": 3,
  "name": "VTOP Command",
  "version": "1.2.0",
  "description": "Jump to VTOP pages with Cmd+K, and give VTOP a comfortable dark mode.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vtop.vit.ac.in/vtop/*"
      ],
      "js": [
        "brand.js",
        "combobox.js",
        "search-select.js",
        "form-presets.js",
        "navigation.js",
        "semesters.js",
        "enhancements.js",
        "page-actions.js",
        "cgpa.js",
        "content.js",
        "dark-readability.js",
        "cgpa-ui.js",
        "page-enhancements.js",
        "pdf-preview.js",
        "captcha.js"
      ],
      "css": [
        "dark.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vtop.vit.ac.in/vtop/*"
      ],
      "js": [
        "page-runtime.js",
        "pdf-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf-viewer.html"
      ],
      "matches": [
        "https://vtop.vit.ac.in/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "VTOP Command",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "extension-action.js"
  },
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
